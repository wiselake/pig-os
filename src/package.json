{
  "name": "pig-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "gen:types": "openapi-typescript http://localhost:8000/openapi.json -o src/types/api.generated.ts",
    "preflight": "node scripts/preflight-node.mjs",
    "pretest": "node scripts/preflight-node.mjs",
    "test": "vitest",
    "pretest:run": "node scripts/preflight-node.mjs",
    "test:run": "vitest --run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "test:e2e:live:ui": "playwright test -c playwright.live.config.ts --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.100.11",
    "axios": "^1.16.1",
    "lucide-react": "^1.17.0",
    "next": "^15.3.0",
    "next-intl": "^4.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.76.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.8.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  }
}
